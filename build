#!/usr/bin/env bash
# Cross-compilation matrix build for systat
# Outputs to dist/<os>-<arch>/ subdirectories so artifacts don't collide.
#
# Usage: ./build [--release] [--target TARGET]
#   --release   Build with ReleaseFast optimization (default: Debug)
#   --target X  Build only the specified target (e.g. linux-x86_64)
#   No args     Build all targets

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

OPTIMIZE=""
RELEASE_FLAG=""
SINGLE_TARGET=""
DIST_DIR="dist"
APP_NAME="systat"

while [[ $# -gt 0 ]]; do
	case "$1" in
		--release)
			OPTIMIZE="-Doptimize=ReleaseFast"
			RELEASE_FLAG="--release=fast"
			shift
			;;
		--target)
			SINGLE_TARGET="$2"
			shift 2
			;;
		--help|-h)
			echo "Usage: $0 [--release] [--target TARGET]"
			echo ""
			echo "Targets:"
			echo "  macos-aarch64       macOS ARM64 (Apple Silicon) — native only"
			echo "  linux-x86_64        Linux x86_64"
			echo "  linux-aarch64       Linux ARM64"
			echo "  windows-x86_64      Windows x86_64"
			echo "  windows-aarch64     Windows ARM64"
			echo "  native              Current platform"
			exit 0
			;;
		*)
			echo "Unknown option: $1 (try --help)"
			exit 1
			;;
	esac
done

# Target label -> Zig target triple
declare -A ZIG_TARGETS=(
	["linux-x86_64"]="x86_64-linux-musl"
	["linux-aarch64"]="aarch64-linux-musl"
	["windows-x86_64"]="x86_64-windows-gnu"
	["windows-aarch64"]="aarch64-windows-gnu"
)

# Cross-compile targets (macOS must be native due to SDL3 sysroot requirement)
CROSS_TARGETS=( "linux-x86_64" "linux-aarch64" "windows-x86_64" "windows-aarch64" )

# Detect native platform label
detect_native_label() {
	local os arch
	os="$(uname -s)"
	arch="$(uname -m)"
	case "$os" in
		Darwin) os="macos" ;;
		Linux)  os="linux" ;;
		*)      os="$(echo "$os" | tr '[:upper:]' '[:lower:]')" ;;
	esac
	case "$arch" in
		x86_64|amd64) arch="x86_64" ;;
		arm64|aarch64) arch="aarch64" ;;
	esac
	echo "${os}-${arch}"
}

NATIVE_LABEL="$(detect_native_label)"

build_target() {
	local label="$1"
	local zig_target="${ZIG_TARGETS[$label]:-}"
	local target_flag=""
	local is_native=false

	if [ -z "$zig_target" ]; then
		# Native build (no -Dtarget flag)
		is_native=true
	else
		target_flag="-Dtarget=$zig_target"
	fi

	# Determine binary name
	local binary="$APP_NAME"
	case "$label" in
		windows-*) binary="${APP_NAME}.exe" ;;
	esac

	local out_dir="$DIST_DIR/$label"
	mkdir -p "$out_dir"

	printf "  %-25s " "$label"

	local start_time
	start_time=$(date +%s)

	if zig build $OPTIMIZE $RELEASE_FLAG $target_flag 2>/tmp/systat-build-$$.log; then
		local end_time
		end_time=$(date +%s)
		local elapsed=$(( end_time - start_time ))

		if [ -f "zig-out/bin/$binary" ]; then
			cp "zig-out/bin/$binary" "$out_dir/$binary"
			local size
			size=$(du -h "$out_dir/$binary" | cut -f1 | tr -d ' ')
			echo "OK  (${elapsed}s, ${size})"

			# Create macOS .app bundle for native macOS builds
			if $is_native && [[ "$(uname)" == "Darwin" ]]; then
				create_app_bundle "$out_dir"
			fi
		else
			echo "OK  (${elapsed}s, binary not in zig-out)"
		fi
	else
		echo "FAIL"
		tail -20 /tmp/systat-build-$$.log
		return 1
	fi
}

create_app_bundle() {
	local out_dir="$1"
	local app_bundle="$out_dir/${APP_NAME}.app"
	local contents="$app_bundle/Contents"
	local macos_dir="$contents/MacOS"
	local resources="$contents/Resources"

	mkdir -p "$macos_dir" "$resources"

	# Copy binary into bundle
	cp "$out_dir/$APP_NAME" "$macos_dir/$APP_NAME"

	# Info.plist
	cat > "$contents/Info.plist" << 'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>systat</string>
    <key>CFBundleDisplayName</key>
    <string>systat</string>
    <key>CFBundleIdentifier</key>
    <string>com.systat.app</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleExecutable</key>
    <string>systat</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
PLIST

	# Create .icns from icon.png if tools are available
	if command -v iconutil &>/dev/null && [[ -f assets/icon.png ]]; then
		local iconset
		iconset=$(mktemp -d)/AppIcon.iconset
		mkdir -p "$iconset"
		for size in 16 32 64 128 256 512; do
			sips -z $size $size assets/icon.png --out "$iconset/icon_${size}x${size}.png" &>/dev/null
		done
		for size in 16 32 128 256 512; do
			local double=$((size * 2))
			sips -z $double $double assets/icon.png --out "$iconset/icon_${size}x${size}@2x.png" &>/dev/null
		done
		iconutil -c icns "$iconset" -o "$resources/AppIcon.icns" 2>/dev/null || true
		rm -rf "$(dirname "$iconset")"
	fi

	local bundle_size
	bundle_size=$(du -sh "$app_bundle" | cut -f1 | tr -d ' ')
	echo "                            -> ${APP_NAME}.app (${bundle_size})"
}

echo "systat cross-compilation matrix build"
echo "======================================"
if [ -n "$OPTIMIZE" ]; then
	echo "Mode: ReleaseFast"
else
	echo "Mode: Debug"
fi
echo "Output: $DIST_DIR/<os>-<arch>/"
echo ""

# Clean dist directory to avoid stale artifacts
rm -rf "$DIST_DIR"
mkdir -p "$DIST_DIR"
FAILED=0

if [ -n "$SINGLE_TARGET" ]; then
	echo "Building:"
	if [ "$SINGLE_TARGET" = "native" ]; then
		build_target "$NATIVE_LABEL" || FAILED=1
	else
		build_target "$SINGLE_TARGET" || FAILED=1
	fi
else
	echo "Native ($NATIVE_LABEL):"
	build_target "$NATIVE_LABEL" || FAILED=1

	echo ""
	echo "Cross-compiling:"
	for target in "${CROSS_TARGETS[@]}"; do
		build_target "$target" || FAILED=$((FAILED + 1))
	done
fi

echo ""
if [ "$FAILED" -eq 0 ]; then
	echo "All builds succeeded."
	echo ""
	# Show tree of dist/
	if command -v tree &>/dev/null; then
		tree -h "$DIST_DIR"
	else
		find "$DIST_DIR" -type f -exec ls -lh {} \; | awk '{print $5, $NF}'
	fi
else
	echo "$FAILED build(s) failed."
	exit 1
fi
